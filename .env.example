# Mẫu biến môi trường LINDY OS. File .env thật KHÔNG commit.
# Ở local, các giá trị dưới được sinh tự động bằng: bun run db:setup && bun scripts/gen-vapid.ts

# Tài khoản quản trị PostgreSQL (postgres) — chỉ dùng để tạo role và DB lần đầu
PG_ADMIN_URL=postgres://postgres:MAT_KHAU@localhost:5433/postgres

# Mật khẩu các role của LINDY (sinh ngẫu nhiên)
LINDY_OWNER_PASSWORD=
LINDY_APP_PASSWORD=

# Server kết nối bằng lindy_app (không có quyền trực tiếp trên bảng; luôn SET ROLE app_user/app_worker)
DATABASE_URL=postgres://lindy_app:MAT_KHAU@localhost:5433/lindy_dev
# Migration chạy bằng lindy_owner
MIGRATE_DATABASE_URL=postgres://lindy_owner:MAT_KHAU@localhost:5433/lindy_dev
# DB test: bắt buộc localhost và tên kết thúc _test
TEST_DATABASE_URL=postgres://lindy_app:MAT_KHAU@localhost:5433/lindy_test
TEST_MIGRATE_DATABASE_URL=postgres://lindy_owner:MAT_KHAU@localhost:5433/lindy_test

# Web Push — khoá riêng của LINDY, không dùng chung CEN WORK
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Email liên hệ thật của quán trước khi chạy thật
VAPID_SUBJECT=mailto:admin@lindy-os.invalid

# Khi chạy sau proxy (Mắt Bão): nguồn công khai của app và tin X-Forwarded-For
# APP_ORIGIN=https://app.ten-mien.vn
# TRUST_PROXY=1

# 0 = tắt tiến trình nền (gửi push, báo lịch quá giờ)
# RUN_WORKER=1
