# ==========================================================
# LINDY OS — biến môi trường khi chạy thật (Vibe Host Mắt Bão)
# Ở máy local, file .env do `bun run db:setup` và `bun scripts/gen-vapid.ts` tự sinh (xem docs/CHAY_LOCAL.md).
# KHÔNG commit giá trị thật.
# ==========================================================

# --- Cơ sở dữ liệu --------------------------------------------------------
# Vibe Host tự điền khi gắn cơ sở dữ liệu vào website (tài khoản quản trị DB).
# Lúc khởi động app dùng nó để tạo role lindy_app, chạy migration, rồi chỉ kết nối bằng lindy_app.
DATABASE_URL=

# --- Bí mật máy chủ (lấy trong .local/prod-env.txt, sinh bằng bun scripts/gen-prod-env.ts) ---
# Mật khẩu role lindy_app: 24–128 ký tự chữ, số, "-" và "_".
LINDY_APP_PASSWORD=
# Web Push — khoá riêng của LINDY, không dùng chung CEN WORK.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# "mailto:" + email liên hệ thật của quán.
VAPID_SUBJECT=

# --- Máy chủ --------------------------------------------------------------
# Địa chỉ công khai của app, không có dấu / cuối.
APP_ORIGIN=https://lindy.n2.tinhgon.xyz
# Chạy sau proxy của Vibe Host: lấy IP người dùng từ X-Forwarded-For.
TRUST_PROXY=1

# --- Tài khoản Chủ đầu tiên -----------------------------------------------
# Chỉ dùng khi DB chưa có tài khoản nào; Linh phải đổi mật khẩu ở lần đăng nhập đầu. Tạo xong có thể xoá.
INITIAL_OWNER_NAME=Linh
INITIAL_OWNER_PHONE=
# Mật khẩu tạm, ít nhất 8 ký tự, không phổ biến.
INITIAL_OWNER_PASSWORD=
