{
  "name": "lindy-os",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "db:start": "bun scripts/db-local.ts start",
    "db:stop": "bun scripts/db-local.ts stop",
    "db:setup": "bun scripts/db-local.ts start && bun scripts/db-bootstrap.ts && bun scripts/migrate.ts up && bun scripts/migrate.ts up --test && bun scripts/seed.ts",
    "db:ping": "bun scripts/db-ping.ts",
    "db:migrate": "bun scripts/migrate.ts up && bun scripts/migrate.ts up --test",
    "db:status": "bun scripts/migrate.ts status",
    "db:reset": "bun scripts/migrate.ts reset",
    "db:seed": "bun scripts/seed.ts",
    "lint": "biome check . && bun scripts/lint-sql.ts",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-start": "1.168.61",
    "lucide-react": "1.55.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "6.1.2",
    "embedded-postgres": "16.14.0-beta.17",
    "nitro": "3.0.260903-beta",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
